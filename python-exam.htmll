<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Python Programming Examination</title>
<link rel="stylesheet" href="css/style.css">

<style>
    .exam-container {
        max-width: 850px;
        margin: 30px auto;
        padding: 25px;
    }

    .timer {
        position: sticky;
        top: 10px;
        z-index: 10;
        background: #2563eb;
        color: white;
        text-align: center;
        padding: 15px;
        border-radius: 10px;
        font-size: 24px;
        font-weight: bold;
        margin: 20px 0;
    }

    .timer.warning {
        background: #dc2626;
    }

    .warning-box {
        display: none;
        background: #fef3c7;
        color: #92400e;
        border: 2px solid #f59e0b;
        border-radius: 10px;
        padding: 18px;
        margin-bottom: 20px;
        font-weight: bold;
        text-align: center;
    }

    .warning-box.show {
        display: block;
    }

    .question {
        background: white;
        padding: 22px;
        border-radius: 12px;
        margin-bottom: 20px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.08);
    }

    .question h3 {
        margin-bottom: 15px;
    }

    .question label {
        display: block;
        padding: 10px;
        margin: 7px 0;
        cursor: pointer;
    }

    .question input {
        margin-right: 10px;
    }

    .submit-btn {
        background: #16a34a;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 15px 28px;
        cursor: pointer;
        font-size: 17px;
    }
</style>
</head>

<body>

<header>
    <h1>Online Examination System</h1>
    <nav>
        <a href="user.html">Dashboard</a>
        <a href="login.html" onclick="logout()">Logout</a>
    </nav>
</header>

<main class="exam-container">

    <h2>🐍 Python Programming Examination</h2>
    <p>5 Questions | 5 Minutes | 5 Marks</p>

    <div class="timer" id="timerBox">
        Time Left: <span id="timer">05:00</span>
    </div>

    <div class="warning-box" id="warningBox" role="alert">
        ⚠️ Warning! Only 1 minute remaining!
        Please complete your exam and submit your answers.
    </div>

    <form id="examForm">

        <div class="question">
            <h3>1. Which keyword defines a function in Python?</h3>
            <label><input type="radio" name="q1" value="a"> function</label>
            <label><input type="radio" name="q1" value="b"> def</label>
            <label><input type="radio" name="q1" value="c"> define</label>
            <label><input type="radio" name="q1" value="d"> fun</label>
        </div>

        <div class="question">
            <h3>2. Which symbol is used for comments in Python?</h3>
            <label><input type="radio" name="q2" value="a"> //</label>
            <label><input type="radio" name="q2" value="b"> /* */</label>
            <label><input type="radio" name="q2" value="c"> #</label>
            <label><input type="radio" name="q2" value="d"> --</label>
        </div>

        <div class="question">
            <h3>3. Which data type uses square brackets?</h3>
            <label><input type="radio" name="q3" value="a"> Tuple</label>
            <label><input type="radio" name="q3" value="b"> Dictionary</label>
            <label><input type="radio" name="q3" value="c"> List</label>
            <label><input type="radio" name="q3" value="d"> String</label>
        </div>

        <div class="question">
            <h3>4. What is the output of print(2 ** 3)?</h3>
            <label><input type="radio" name="q4" value="a"> 6</label>
            <label><input type="radio" name="q4" value="b"> 8</label>
            <label><input type="radio" name="q4" value="c"> 9</label>
            <label><input type="radio" name="q4" value="d"> 5</label>
        </div>

        <div class="question">
            <h3>5. Which function displays output in Python?</h3>
            <label><input type="radio" name="q5" value="a"> echo()</label>
            <label><input type="radio" name="q5" value="b"> display()</label>
            <label><input type="radio" name="q5" value="c"> output()</label>
            <label><input type="radio" name="q5" value="d"> print()</label>
        </div>

        <button class="submit-btn" type="submit">
            Submit Examination
        </button>

    </form>
</main>

<script>
const student = JSON.parse(
    localStorage.getItem("loggedInUser") || "null"
);

if (!student || student.role !== "user") {
    window.location.replace("login.html");
}

const questions = [
    {
        question: "Which keyword defines a function in Python?",
        options: ["function", "def", "define", "fun"],
        correct: "b",
        explanation: "The def keyword defines functions in Python."
    },
    {
        question: "Which symbol is used for comments in Python?",
        options: ["//", "/* */", "#", "--"],
        correct: "c",
        explanation: "Python uses # for single-line comments."
    },
    {
        question: "Which data type uses square brackets?",
        options: ["Tuple", "Dictionary", "List", "String"],
        correct: "c",
        explanation: "Python lists use square brackets."
    },
    {
        question: "What is the output of print(2 ** 3)?",
        options: ["6", "8", "9", "5"],
        correct: "b",
        explanation: "The ** operator performs exponentiation. 2 cubed is 8."
    },
    {
        question: "Which function displays output in Python?",
        options: ["echo()", "display()", "output()", "print()"],
        correct: "d",
        explanation: "The print() function displays output."
    }
];

let submitted = false;
let warningShown = false;

// Change 300 to 65 temporarily for quick testing.
const examDuration = 300;
const endTime = Date.now() + examDuration * 1000;

const countdown = setInterval(updateTimer, 250);

document.getElementById("examForm").addEventListener(
    "submit",
    function(event) {
        event.preventDefault();
        submitExam();
    }
);

function updateTimer() {
    if (submitted) return;

    const remaining = Math.max(
        0,
        Math.ceil((endTime - Date.now()) / 1000)
    );

    const minutes = Math.floor(remaining / 60);
    const seconds = remaining % 60;

    document.getElementById("timer").textContent =
        String(minutes).padStart(2, "0") + ":" +
        String(seconds).padStart(2, "0");

    if (remaining <= 60 && remaining > 0 && !warningShown) {
        warningShown = true;

        document.getElementById("warningBox")
            .classList.add("show");

        document.getElementById("timerBox")
            .classList.add("warning");
    }

    if (remaining === 0) {
        submitExam();
    }
}

function submitExam() {
    if (submitted) return;

    submitted = true;
    clearInterval(countdown);

    let score = 0;

    const review = questions.map(function(item, index) {
        const selected = document.querySelector(
            'input[name="q' + (index + 1) + '"]:checked'
        );

        const selectedValue = selected ? selected.value : null;

        const correctIndex =
            item.correct.charCodeAt(0) - 97;

        const selectedIndex = selectedValue
            ? selectedValue.charCodeAt(0) - 97
            : -1;

        const isCorrect = selectedValue === item.correct;

        if (isCorrect) score++;

        return {
            question: item.question,
            yourAnswer: selectedIndex >= 0
                ? item.options[selectedIndex]
                : "Not answered",
            correctAnswer: item.options[correctIndex],
            isCorrect: isCorrect,
            explanation: item.explanation
        };
    });

    localStorage.setItem(
        "pythonReview",
        JSON.stringify(review)
    );

    localStorage.setItem("pythonScore", score);

    const results = JSON.parse(
        localStorage.getItem("allExamResults") || "[]"
    );

    results.push({
        studentName: student.name,
        studentEmail: student.email,
        exam: "Python Programming",
        marks: score,
        total: 5,
        percentage: score * 20,
        status: score >= 3 ? "Pass" : "Fail",
        date: new Date().toLocaleString()
    });

    localStorage.setItem(
        "allExamResults",
        JSON.stringify(results)
    );

    window.location.href = "python-result.html";
}

function logout() {
    localStorage.removeItem("loggedInUser");
}
</script>

</body>
</html>